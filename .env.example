# Vendor Management API - Environment Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret Key (REQUIRED)
# Generate a secure random key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=_WcQ70v6jX0S3pTiDFYtqEPTgggBPbvWhe6pRnC79C8

# JWT Token Expiration (in hours)
# Default: 24 hours
ACCESS_TOKEN_EXPIRE_HOURS=24

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL
# SQLite (default): sqlite:///./app.db
# PostgreSQL: postgresql://user:password@localhost/dbname
# MySQL: mysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./app.db

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP Server Configuration
# Leave empty to disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Email Settings
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Environment
# Options: development, staging, production
ENVIRONMENT=development

# Debug Mode
# Set to true for development, false for production
DEBUG=true

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API Version
API_VERSION=v1

# CORS Origins (comma-separated)
# Use * for development, specify domains for production
CORS_ORIGINS=*

# =============================================================================
# REMINDER CONFIGURATION
# =============================================================================

# Reminder Settings
# Days before expiry to send reminders
EXPIRY_REMINDER_DAYS=15

# Days before payment due to send reminders
PAYMENT_REMINDER_DAYS=15

# Enable/disable daily reminder job
ENABLE_DAILY_REMINDERS=false

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server Host
HOST=0.0.0.0

# Server Port
PORT=8000

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Auto-reload on code changes (development only)
RELOAD=true

# Watch directories for changes
WATCH_DIRS=.

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# Workers (production only)
# Set to number of CPU cores
WORKERS=1

# Maximum request size (in bytes)
MAX_REQUEST_SIZE=10485760

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Health check endpoint
HEALTH_CHECK_PATH=/healthz

# Metrics endpoint (if enabled)
METRICS_PATH=/metrics

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Example for PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/vendor_management

# Example for MySQL:
# DATABASE_URL=mysql://username:password@localhost:3306/vendor_management

# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com

# Example for SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@yourdomain.com
